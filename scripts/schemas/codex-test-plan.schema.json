{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Test Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "proposed_test_files",
    "recommended_command",
    "risks",
    "plan_text",
    "framework_guess"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "proposed_test_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recommended_command": {
      "type": "string",
      "minLength": 1
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "plan_text": {
      "type": "string",
      "minLength": 1
    },
    "framework_guess": {
      "type": "string",
      "minLength": 1
    }
  }
}
